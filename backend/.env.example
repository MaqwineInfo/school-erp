# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# MUST be a replica set — multi-document transactions are unavailable on a standalone
# mongod, and fee collection, payroll and enrolment all depend on them.
#   mongod --replSet rs0 --dbpath ./data
#   mongosh --eval 'rs.initiate()'
MONGODB_URI=mongodb://localhost:27017/school-erp?replicaSet=rs0

# ─── JWT / Auth ────────────────────────────────────────────────────────────────
# Required. No default — the app refuses to start without it, and must be >= 32 chars
# in production.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_ISSUER=school-erp

BCRYPT_ROUNDS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_OTP_TTL_SECONDS=300

# ─── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
# Failed auth attempts only — successful logins do not count towards this.
RATE_LIMIT_AUTH_MAX=20

# ─── Scheduler / events ────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
OUTBOX_INTERVAL_MS=5000
IDEMPOTENCY_TTL_HOURS=24

# ─── Storage ───────────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=school-erp-uploads

# ─── Credential encryption ─────────────────────────────────────────────────────
# Encrypts tenant integration secrets (payment/SMS/WhatsApp/SMTP keys) at rest.
# Falls back to JWT_SECRET outside production. Set this explicitly in production.
CREDENTIAL_ENCRYPTION_KEY=

# ─── Super Admin (used by the seeder) ─────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@schoolerp.com
SUPER_ADMIN_PASSWORD=Admin@123456

# ─── Integrations ──────────────────────────────────────────────────────────────
# Per-tenant provider credentials live in Tenant.integrations (encrypted), NOT here.
# Every capability defaults to a `noop` driver, so development needs no keys at all —
# sends are logged instead of dispatched. See docs/architecture/system-architecture.md §12.
