# ============================================================
# Enterprise School ERP — Backend Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# Application
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# MongoDB
MONGO_URI=mongodb+srv://maqwineinfotech:goforreview2025@goforreview.myjp1xj.mongodb.net/school-erp
MONGO_DB_NAME=school-erp

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Encryption (AES-256 for PII fields like PAN, bank account)
ENCRYPTION_KEY=32-char-hex-key-change-this-now!

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=school-erp-files
CLOUDFRONT_DOMAIN=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS (DLT provider — e.g. Fast2SMS / MSG91)
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=SCHLERP
SMS_DLT_TE_ID=

# WhatsApp Business API
WA_API_URL=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Email (AWS SES)
SES_REGION=ap-south-1
SES_FROM_EMAIL=noreply@schoolerp.in
SES_FROM_NAME=School ERP

# FCM (Push Notifications)
FCM_SERVER_KEY=

# Super Admin (first run only)
SUPERADMIN_EMAIL=superadmin@schoolerp.in
SUPERADMIN_PASSWORD=change-this-immediately

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,https://app.schoolerp.in

# Logging
LOG_LEVEL=info
LOG_DIR=./logs
